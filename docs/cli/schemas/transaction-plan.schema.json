                          "properties": {
                            "type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "name": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "additionalProperties": true
                        },
                        "minItems": 1
                      }
                    },
                    "additionalProperties": true
                  },
                  "catalog": {
                    "type": "object",
                    "required": [
