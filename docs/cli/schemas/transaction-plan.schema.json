                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "path",
                        "path_base",
                        "role",
                        "bytes",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
