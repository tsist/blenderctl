                        "path_base": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "role": {
                          "type": "string",
                          "minLength": 1
                        },
                        "bytes": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "additionalProperties": true
                    },
                    "minItems": 1
