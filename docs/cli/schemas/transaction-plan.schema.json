                          "denied"
                        ]
                      },
                      "intended_use": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "license_evidence_path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "license_evidence_sha256": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": true
                  },
                  "dependencies": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  },
                  "validation": {
                    "type": "object",
                    "required": [
