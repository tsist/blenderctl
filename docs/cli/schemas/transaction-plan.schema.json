                        "required": [
                          "file",
                          "expected_sha256"
                        ],
                        "properties": {
                          "file": {
                            "type": "string",
                            "minLength": 1
                          },
                          "expected_sha256": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{64}$"
                          }
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true,
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "title": "Blender asset record 1.0 populated index entry"
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "catalog_text": {
              "type": "string",
              "minLength": 1
            },
            "file_map": {
              "type": "object",
              "additionalProperties": {
