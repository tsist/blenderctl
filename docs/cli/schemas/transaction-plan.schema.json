                "properties": {
                  "schema_version": {
                    "const": "1.0"
                  },
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "MOD",
                      "MAT",
                      "TEX",
                      "HDR",
                      "LGT",
                      "GEO",
                      "SHD",
                      "CMP",
                      "RIG",
                      "ANI",
                      "SCN",
                      "BRU"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^v[0-9]{3,}$"
                  },
                  "lifecycle": {
                    "enum": [
                      "source",
                      "master",
                      "working",
                      "published",
                      "quarantine",
                      "archived"
