                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_identity": {
                "$ref": "#/$defs/fileIdentity"
              },
              "target_parent_identity": {
                "$ref": "#/$defs/fileIdentity"
              },
              "source_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "target_before": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "output_sha256",
                      "file_identity"
                    ],
                    "properties": {
                      "output_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "file_identity": {
                        "$ref": "#/$defs/fileIdentity"
                      }
                    }
                  }
                ]
              },
              "kind": {
                "enum": [
                  "blend",
                  "blend_exact",
                  "catalog",
                  "json",
                  "catalog_repair"
                ]
              },
              "mode": {
                "enum": [
                  "create",
                  "replace"
                ]
              },
              "target_backup": {
                "type": "string",
                "minLength": 1
              },
              "catalog_mapping": {
                "type": "object"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+[\\\\/]|/)"
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ]
                },
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "replace"
                    }
                  }
                },
                "then": {
                  "required": [
                    "target_backup"
                  ],
                  "properties": {
                    "target_before": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "target_before": {
                      "type": "null"
                    }
                  },
                  "not": {
                    "required": [
                      "target_backup"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "replace"
                    },
                    "kind": {
                      "const": "catalog"
                    }
                  }
                },
                "then": {
                  "required": [
                    "catalog_mapping"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "catalog_repair"
                    }
                  }
                },
                "then": {
                  "required": [
                    "catalog_mapping"
                  ],
                  "properties": {
                    "mode": {
                      "const": "replace"
                    }
                  }
                }
              }
            ]
          },
          "contains": {
            "required": [
              "dependencies"
            ]
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overwrite",
            "relative_paths",
            "version",
            "validation",
            "purpose",
            "upstream_dependencies"
          ],
          "properties": {
            "overwrite": {
              "const": "preserve_then_publish"
            },
            "relative_paths": {
              "enum": [
                "remap_to_target_parent",
                "per_item_remap_or_exact_resolved_inputs"
              ]
            },
            "version": {
              "const": "same_major_minor_only"
