            "validation": {
              "const": "structural_not_full_functional"
            },
            "purpose": {
              "enum": [
                "working_copy_not_asset_publication",
                "validated_asset_library"
              ]
            },
            "upstream_dependencies": {
              "const": "hash_locked_through_commit"
            }
          }
        },
        "asset_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "minLength": 1
            },
            "records": {
