                      "uuid",
                      "path"
                    ],
                    "properties": {
                      "library_root": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "uuid": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-fA-F-]{36}$"
                      },
                      "path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": true
                  },
                  "source": {
                    "type": "object",
                    "required": [
