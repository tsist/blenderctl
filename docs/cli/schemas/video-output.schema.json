{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blenderctl:video-output.schema.json",
  "title": "Video output options",
  "$comment": "Strict shared structure; normalize validates absolute paths, half-open ranges, sampling, SHA/resource closure and full output budget. HDR is an explicit Standard100 technical route with virtual mastering; measured mastering, device viewing and complete normative certification are not implied.",
  "type": "object",
  "properties": {
    "format": {
      "enum": [
        "PNG",
        "MP4"
      ]
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -1048574,
        "maximum": 1048575
      },
      "minItems": 2,
      "maxItems": 2
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536,
      "description": "Optional exact integer-percent downscale of authored canvas; use timeline+fit edits for another canvas."
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "shots": {
      "type": "boolean"
    },
    "preview": {
      "type": "object",
      "properties": {
        "proxies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "clip_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "source_files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32767,
                      "description": "Absolute local path; runtime checks path and resource closure."
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32767,
                      "description": "Absolute local path; runtime checks path and resource closure."
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "clip_id",
              "source_files",
              "files"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "proxies"
      ],
      "additionalProperties": false
    },
    "shot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "description": "Explicit active visual shot_id selection; only valid with shots=true. Missing clip shot_id falls back to clip id; TEXT/SOUND are not shots."
    },
    "subtitles": {
      "type": "boolean"
    },
    "audio": {
      "type": "boolean"
    },
    "max_pixel_frames": {
      "type": "integer",
      "minimum": 1
    },
    "ffmpeg": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "description": "Absolute local path; runtime checks path and resource closure."
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "expected_sha256"
      ],
      "additionalProperties": false
    },
    "ffprobe": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767,
          "description": "Absolute local path; runtime checks path and resource closure."
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "expected_sha256"
      ],
      "additionalProperties": false
    },
    "hdr": {
      "type": "object",
      "properties": {
        "ocio": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32767,
              "description": "Absolute local path; runtime checks path and resource closure."
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ],
          "additionalProperties": false
        },
        "mapping": {
          "type": "string",
          "const": "STANDARD_100"
        },
        "reference_white_nits": {
          "type": "integer",
          "const": 100
        },
        "exposure": {
          "type": "integer",
          "const": 0
        },
        "mastering": {
          "type": "string",
          "const": "VIRTUAL_BT2020_10000NIT"
        },
        "alpha": {
          "type": "string",
          "const": "REQUIRE_OPAQUE"
        }
      },
      "required": [
        "ocio",
        "mapping",
        "reference_white_nits",
        "exposure",
        "mastering",
        "alpha"
      ],
      "additionalProperties": false
    },
    "color_mode": {
      "enum": [
        "SDR",
        "HDR10_PQ"
      ],
      "description": "HDR10_PQ requires explicit Standard100, active SHA-bound OCIO, virtual mastering and opaque output; technical qualification is separate from device viewing."
    }
  },
  "required": [
    "format",
    "max_pixel_frames"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "color_mode": {
            "const": "HDR10_PQ"
          }
        },
        "required": [
          "color_mode"
        ]
      },
      "then": {
        "properties": {
          "format": {
            "const": "MP4"
          }
        },
        "required": [
          "hdr",
          "ffmpeg",
          "ffprobe"
        ]
      },
      "else": {
        "not": {
          "required": [
            "hdr"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "shot_ids"
        ]
      },
      "then": {
        "required": [
          "shots"
        ],
        "properties": {
          "shots": {
            "const": true
          }
        }
      }
    }
  ]
}
