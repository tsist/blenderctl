{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-preview.schema.json",
  "title": "Compositing preview shared workflow 1.0/1.1/1.2/1.3",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": -100000,
        "maximum": 100000
      }
    },
    "samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "engine": {
      "enum": [
        "SOURCE",
        "CYCLES",
        "BLENDER_EEVEE"
      ]
    },
    "camera": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "device": {
      "type": "object",
      "properties": {
        "backend": {
          "enum": [
            "CPU",
            "CUDA",
            "OPTIX",
            "GRAPHICS"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "backend"
      ],
      "additionalProperties": false
    },
    "compositor_device": {
      "enum": [
        "GPU",
        "CPU"
      ]
    },
    "allow_cpu_fallback": {
      "type": "boolean"
    },
    "precision": {
      "const": "FULL"
    },
    "baseline": {
      "type": "boolean"
    },
    "pixel_frame_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483648
    },
    "timeline": {
      "type": "object",
      "properties": {
        "scene_start": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "scene_fps": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scene_start",
        "frame_count",
        "scene_fps"
      ],
      "additionalProperties": false
    },
    "video": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "const": true
            },
            "kind": {
              "const": "SDR_MP4_H264"
            },
            "alpha_policy": {
              "const": "COMPOSITE_BLACK"
            },
            "runtime": {
              "type": "object",
              "properties": {
                "ffmpeg": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ],
                  "additionalProperties": false
                },
                "ffprobe": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "ffmpeg",
                "ffprobe"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "enabled",
            "kind",
            "alpha_policy",
            "runtime"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": false,
  "allOf": [
    {
      "not": {
        "required": [
          "frames",
          "timeline"
        ]
      }
    },
    {
      "if": {
        "required": [
          "video"
        ],
        "properties": {
          "video": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "timeline"
        ]
      }
    }
  ]
}
