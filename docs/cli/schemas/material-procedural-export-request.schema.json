{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "material.procedural-export request 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "const": "material.procedural-export"
    },
    "params": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file",
              "expected_sha256"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "context": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "view_layer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "frame": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          "required": [
            "scene",
            "view_layer"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "object": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "material_slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63,
              "default": 0
            },
            "uv_layer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          },
          "required": [
            "object",
            "uv_layer"
          ],
          "additionalProperties": false
        },
        "export": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "PBR texture export settings",
          "type": "object",
          "properties": {
            "channels": {
              "type": "array",
              "items": {
                "enum": [
                  "base_color",
                  "roughness",
                  "metallic",
                  "normal",
                  "height",
                  "alpha",
                  "transmission",
                  "ior",
                  "coat_weight",
                  "coat_roughness"
                ]
              },
              "minItems": 1,
              "uniqueItems": true,
              "default": [
                "base_color",
                "roughness",
                "metallic",
                "normal"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048,
              "default": 2048
            },
            "margin": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128,
              "default": 16
            },
            "samples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256,
              "default": 16
            },
            "bit_depth": {
              "enum": [
                "8",
                "16"
              ],
              "default": "16"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "file",
        "expected_sha256",
        "resources",
        "context",
        "target",
        "export"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command",
    "params"
  ],
  "additionalProperties": false
}
