{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dependency-relink-manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1.0"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "expected_sha256"
      ]
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "expected_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "file",
                    "expected_sha256"
                  ]
                }
              },
              "required": [
                "from",
                "to"
              ]
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "resource_id",
          "members"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "version",
    "baseline",
    "mappings"
  ]
}
