{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tracking-resources 1.0",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "frame": {
        "type": "integer",
        "minimum": 1,
        "maximum": 120
      },
      "file": {
        "type": "string",
        "minLength": 1
      },
      "expected_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required": [
      "frame",
      "file",
      "expected_sha256"
    ]
  },
  "minItems": 2,
  "maxItems": 120
}
