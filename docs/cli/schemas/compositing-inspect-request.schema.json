{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-inspect-request.schema.json",
  "title": "compositing.inspect shared workflow 1.0/1.1/1.2/1.3 contract",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "const": "compositing.inspect"
    },
    "params": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resources": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file",
              "expected_sha256"
            ],
            "additionalProperties": false
          }
        },
        "scene": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "expected_sha256",
        "resources",
        "scene",
        "workflow_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command",
    "params"
  ],
  "additionalProperties": false
}
