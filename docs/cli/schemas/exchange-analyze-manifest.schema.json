{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exchange-analyze-manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scene": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "view_layer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "frame_start": {
      "type": "number",
      "minimum": 1,
      "maximum": 100000
    },
    "frame_end": {
      "type": "number",
      "minimum": 1,
      "maximum": 100000
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed_substeps": {
          "type": "integer",
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "max_evaluations": {
          "type": "integer",
          "minimum": 5,
          "maximum": 4096
        },
        "max_vertex_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        },
        "max_position_error": {
          "type": "number",
          "minimum": 1e-07,
          "maximum": 0.001
        }
      },
      "required": [
        "seed_substeps",
        "max_depth",
        "max_evaluations",
        "max_vertex_samples",
        "max_position_error"
      ]
    }
  },
  "required": [
    "scene",
    "view_layer",
    "objects",
    "frame_start",
    "frame_end",
    "sampling"
  ]
}
