{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "media-export-report 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "media_export_version": {
      "const": "1.0"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "format": {
          "enum": [
            "PNG_SEQUENCE",
            "MP4_H264_AAC",
            "WAV_PCM16"
          ]
        },
        "frame_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "frame_end": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "color": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view": {
              "enum": [
                "Standard",
                "AgX",
                "Raw"
              ]
            },
            "exposure": {
              "type": "number",
              "minimum": -10,
              "maximum": 10
            },
            "gamma": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            }
          },
          "required": [
            "view",
            "exposure",
            "gamma"
          ]
        }
      },
      "required": [
        "scene",
        "format",
        "frame_start",
        "frame_end",
        "color"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "minimum": 0
                },
                "channels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "format": {
                  "type": "string"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "infinite_values": {
                  "type": "integer",
                  "minimum": 0
                },
                "mean": {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "required": [
                "width",
                "height",
                "channels",
                "format",
                "min",
                "max",
                "infinite_values",
                "mean"
              ]
            }
          },
          "frame": {
            "type": "integer",
            "minimum": 0
          },
          "audio": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "channels": {
                "type": "integer",
                "minimum": 0
              },
              "rate": {
                "type": "integer",
                "minimum": 0
              },
              "sample_frames": {
                "type": "integer",
                "minimum": 0
              },
              "seconds": {
                "type": "number"
              }
            },
            "required": [
              "channels",
              "rate",
              "sample_frames",
              "seconds"
            ]
          },
          "video": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frames": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "fps": {
                "type": "integer",
                "minimum": 0
              },
              "codec_request": {
                "type": "string"
              },
              "audio_verification": {
                "type": "string"
              }
            },
            "required": [
              "frames",
              "width",
              "height",
              "fps",
              "codec_request",
              "audio_verification"
            ]
          }
        },
        "required": [
          "file",
          "sha256",
          "bytes"
        ],
        "oneOf": [
          {
            "required": [
              "images",
              "frame"
            ]
          },
          {
            "required": [
              "audio"
            ]
          },
          {
            "required": [
              "video"
            ]
          }
        ]
      }
    },
    "resource_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "seconds": {
      "type": "number"
    },
    "source_saved": {
      "const": false
    },
    "timeline_authority": {
      "type": "string"
    }
  },
  "required": [
    "media_export_version",
    "settings",
    "outputs",
    "resource_hashes",
    "seconds",
    "source_saved",
    "timeline_authority"
  ]
}
