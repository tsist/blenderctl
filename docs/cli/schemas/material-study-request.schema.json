          },
          "then": {
            "properties": {
              "manifest": {
                "properties": {
                  "preview": {
                    "properties": {
                      "views": {
                        "maxItems": 6
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "study": {
                "properties": {
                  "cases": {
                    "minItems": 5,
                    "maxItems": 5
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "manifest": {
                "properties": {
                  "preview": {
                    "properties": {
                      "views": {
                        "maxItems": 6
                      }
                    }
