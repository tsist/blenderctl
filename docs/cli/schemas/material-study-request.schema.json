          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest": {
          "$ref": "material-batch-manifest.schema.json",
          "allOf": [
            {
              "properties": {
                "preview": {
                  "properties": {
                    "views": {
                      "maxItems": 6
                    }
                  }
                }
              }
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
