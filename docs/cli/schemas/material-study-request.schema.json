            },
            "layer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48,
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                  },
                  "values": {
                    "type": "object",
                    "properties": {
                      "normal_strength": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 10
                      },
                      "roughness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "metallic": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "ior": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "coat_weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "coat_roughness": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "coat_ior": {
                        "type": "number",
                        "minimum": 1,
                        "maximum": 4
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  },
                  "color_mode": {
                    "enum": [
                      "original",
                      "white"
                    ],
                    "default": "original"
                  }
                },
                "required": [
                  "id",
                  "values"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 8
            },
            "semantic_analysis": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "assignment_id",
            "layer_id",
            "cases"
          ],
          "additionalProperties": false
