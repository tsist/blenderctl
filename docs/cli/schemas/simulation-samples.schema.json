{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "simulation-samples 1.0",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "frame": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      },
      "objects": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "vertices": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "required": [
            "name",
            "vertices"
          ]
        }
      },
      "density": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "sum": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000.0
            }
          },
          "required": [
            "name",
            "count",
            "sum",
            "max"
          ]
        }
      },
      "liquid": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "vertices": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000000000.0,
                  "maximum": 1000000000.0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 0,
              "maxItems": 100000
            },
            "faces": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200000
            },
            "topology_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "name",
            "vertices",
            "faces",
            "topology_sha256"
          ]
        }
      }
    },
    "required": [
      "frame",
      "objects",
      "density"
    ]
  }
}
