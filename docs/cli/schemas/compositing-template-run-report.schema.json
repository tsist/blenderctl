{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-template-run-report.schema.json",
  "type": "object",
  "properties": {
    "report_version": {
      "const": "1.0"
    },
    "operation": {
      "const": "compositing.template-run"
    },
    "status": {
      "enum": [
        "running",
        "passed",
        "partial",
        "failed",
        "cancelled",
        "timed_out",
        "mock_only"
      ]
    },
    "attempt_directory": {
      "type": "string"
    },
    "request": {
      "type": "object"
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object"
    },
    "evidence_kind": {
      "enum": [
        "normal_host",
        "mock_only"
      ]
    },
    "certified_producer": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "domain_status_observed": {
      "enum": [
        "passed",
        "partial",
        "failed"
      ]
    },
    "guard_validation": {
      "type": "object",
      "properties": {
        "initial_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "final_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "file_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "ancestor_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "ancestors": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "status",
        "files",
        "ancestors",
        "final_full_sha",
        "file_path_identity_checks",
        "ancestor_path_identity_checks"
      ],
      "additionalProperties": false
    },
    "parent_guard_validation": {
      "type": "object",
      "properties": {
        "initial_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "final_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "file_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "ancestor_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "ancestors": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "status",
        "files",
        "ancestors",
        "final_full_sha",
        "file_path_identity_checks",
        "ancestor_path_identity_checks"
      ],
      "additionalProperties": false
    },
    "closure_guard_validation": {
      "type": "object",
      "properties": {
        "initial_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "final_full_sha": {
          "type": "integer",
          "minimum": 0
        },
        "file_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "ancestor_path_identity_checks": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "ancestors": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "status",
        "files",
        "ancestors",
        "final_full_sha",
        "file_path_identity_checks",
        "ancestor_path_identity_checks"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file"
      ],
      "anyOf": [
        {
          "required": [
            "sha256"
          ]
        },
        {
          "required": [
            "expected_sha256"
          ]
        }
      ],
      "additionalProperties": false
    },
    "producer_validation": {
      "enum": [
        "not_run",
        "passed"
      ]
    },
    "normal_run_report": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file"
          ],
          "anyOf": [
            {
              "required": [
                "sha256"
              ]
            },
            {
              "required": [
                "expected_sha256"
              ]
            }
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "normal_run_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resolved_run_params": {
      "type": "object"
    },
    "stage": {
      "type": "string"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file"
      ],
      "anyOf": [
        {
          "required": [
            "sha256"
          ]
        },
        {
          "required": [
            "expected_sha256"
          ]
        }
      ],
      "additionalProperties": false
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recovery": {
      "type": "object"
    },
    "seam_mock": {
      "type": "boolean"
    }
  },
  "required": [
    "report_version",
    "operation",
    "status",
    "attempt_directory"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "cancelled",
              "timed_out"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "mock_only"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "mock_only"
          },
          "certified_producer": {
            "const": false
          }
        },
        "required": [
          "evidence_kind",
          "certified_producer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed",
              "partial"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "implementation_sha256",
          "runtime",
          "request_fingerprint"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed",
              "partial"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "template",
          "normal_run_report",
          "normal_run_signature",
          "candidate",
          "outputs",
          "producer_validation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "producer_validation": {
            "const": "passed"
          },
          "seam_mock": {
            "const": false
          }
        },
        "required": [
          "seam_mock"
        ]
      }
    }
  ]
}
