{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pipeline-runtime 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cli_version": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "blender_build": {
      "type": "string"
    },
    "runtime_inventory": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sha256",
              "bytes"
            ]
          }
        ]
      }
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "cli_version",
    "hashes",
    "runtime_inventory",
    "scope"
  ]
}
