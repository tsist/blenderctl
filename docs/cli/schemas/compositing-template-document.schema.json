{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-template-document.schema.json",
  "type": "object",
  "properties": {
    "template_version": {
      "const": "1.0"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "recipe": {
      "type": "object",
      "properties": {
        "workflow_version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
              },
              "kind": {
                "enum": [
                  "exposure",
                  "blur",
                  "glare",
                  "hue_saturation",
                  "color_spill",
                  "transform",
                  "scale",
                  "lens_distortion"
                ]
              },
              "params": {
                "type": "object",
                "maxProperties": 16
              }
            },
            "required": [
              "id",
              "kind",
              "params"
            ],
            "additionalProperties": false
          }
        },
        "graph": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                  },
                  "type": {
                    "enum": [
                      "CompositorNodeExposure",
                      "CompositorNodeBlur",
                      "CompositorNodeGlare",
                      "CompositorNodeHueSat",
                      "CompositorNodeBrightContrast",
                      "CompositorNodeInvert",
                      "CompositorNodeAlphaOver",
                      "CompositorNodeSetAlpha",
                      "CompositorNodePremulKey",
                      "CompositorNodeRGB",
                      "CompositorNodeCombineColor",
                      "CompositorNodeSeparateColor",
                      "ShaderNodeMath",
                      "ShaderNodeVectorMath",
                      "ShaderNodeMix",
                      "ShaderNodeMapRange",
                      "ShaderNodeClamp",
                      "ShaderNodeValToRGB",
                      "ShaderNodeRGBCurve",
                      "ShaderNodeFloatCurve",
                      "ShaderNodeVectorCurve",
                      "ShaderNodeSeparateXYZ",
                      "ShaderNodeCombineXYZ",
                      "ShaderNodeValue",
                      "CompositorNodeImage",
                      "CompositorNodeRLayers",
                      "CompositorNodeDenoise",
                      "CompositorNodeDefocus",
                      "CompositorNodeDilateErode",
                      "CompositorNodeBoxMask",
                      "CompositorNodeEllipseMask",
                      "CompositorNodeKeying",
                      "CompositorNodeColorSpill",
                      "CompositorNodeTransform",
                      "CompositorNodeScale",
                      "CompositorNodeLensdist"
                    ]
                  },
                  "inputs": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64
                  },
                  "properties": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64
                  },
                  "outputs": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 64
                  }
                },
                "required": [
                  "id",
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "properties": {
                  "from_node": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "from_socket": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "to_node": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "to_socket": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                },
                "required": [
                  "from_node",
                  "from_socket",
                  "to_node",
                  "to_socket"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "nodes",
            "links"
          ],
          "additionalProperties": false
        },
        "animation": {
          "type": "object",
          "properties": {
            "animation_version": {
              "const": "1.0"
            },
            "tracks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "object",
                    "properties": {
                      "node": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                      },
                      "domain": {
                        "enum": [
                          "inputs",
                          "outputs",
                          "properties"
                        ]
                      },
                      "identifier": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      }
                    },
                    "required": [
                      "node",
                      "domain",
                      "identifier"
                    ],
                    "additionalProperties": false
                  },
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 300,
                    "items": {
                      "type": "object",
                      "properties": {
                        "frame": {
                          "type": "integer",
                          "minimum": -100000,
                          "maximum": 100000
                        },
                        "value": {
                          "oneOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 4,
                              "items": {
                                "type": "number"
                              }
                            }
                          ]
                        },
                        "interpolation": {
                          "enum": [
                            "LINEAR",
                            "CONSTANT"
                          ]
                        }
                      },
                      "required": [
                        "frame",
                        "value",
                        "interpolation"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "extrapolation": {
                    "const": "CONSTANT"
                  }
                },
                "required": [
                  "target",
                  "keys",
                  "extrapolation"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "animation_version",
            "tracks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workflow_version"
      ],
      "additionalProperties": false
    },
    "source_slot": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "required"
      ],
      "additionalProperties": false
    },
    "binding_slots": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "image",
              "render_layers",
              "image_sequence",
              "movie"
            ]
          },
          "node_type": {
            "enum": [
              "CompositorNodeImage",
              "CompositorNodeRLayers"
            ]
          },
          "requires_layer": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "node_type",
          "requires_layer"
        ],
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ],
          "additionalProperties": false
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "version_tuple": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              }
            },
            "build": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "version_tuple",
            "build",
            "binary_sha256"
          ],
          "additionalProperties": false
        },
        "candidate": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "sha256"
          ],
          "additionalProperties": false
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "producer",
        "implementation_sha256",
        "runtime",
        "candidate",
        "scope"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "template_version",
    "template_id",
    "recipe",
    "source_slot",
    "binding_slots",
    "provenance"
  ],
  "additionalProperties": false
}
