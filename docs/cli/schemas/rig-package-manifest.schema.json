{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rig-package-manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "const": "NATIVE_RIG_PACKAGE_V1"
    },
    "scope": {
      "const": "WHOLE_PROJECT"
    },
    "scene": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "view_layer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 1,
        "maximum": 100000
      },
      "minItems": 2,
      "maxItems": 120,
      "uniqueItems": true
    }
  },
  "required": [
    "adapter",
    "scope",
    "scene",
    "view_layer",
    "objects",
    "frames"
  ]
}
