{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job-resources 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32768
        },
        "disk_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "gpu_mb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      },
      "required": [
        "cpu_threads",
        "memory_mb",
        "disk_mb",
        "gpu_mb"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observed_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "peak_job_committed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "job_memory_limit_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "limit_flags": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": []
    },
    "memory_semantics": {
      "type": "string"
    },
    "disk_semantics": {
      "type": "string"
    },
    "gpu_semantics": {
      "type": "string"
    }
  },
  "required": [
    "limits",
    "usage",
    "memory_semantics",
    "disk_semantics",
    "gpu_semantics"
  ]
}
