          "maxLength": 160
        },
        "sun_rotation_deg": {
          "type": "number",
          "minimum": -36000,
          "maximum": 36000
        },
        "sun_elevation_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "sun_disc": {
          "type": "boolean",
          "description": "Native Sky sun disc is Cycles-only; Eevee does not support this sun-disc control. Use an explicit SUN light for direct light."
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "exposure": {
      "type": "number",
      "minimum": -10,
      "maximum": 10
    },
