                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "location": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1000,
                  "maximum": 1000
                },
                "minItems": 3,
                "maxItems": 3
              },
              "size": {
                "type": "number",
                "minimum": 1e-05,
                "maximum": 10000
              },
              "size_y": {
                "type": "number",
                "minimum": 1e-05,
                "maximum": 10000
              },
              "enabled": {
                "type": "boolean"
              },
              "use_shadow": {
                "type": "boolean"
              },
              "receivers": {
                "type": "array",
