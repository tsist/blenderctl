{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "preview-receipt 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "preview_receipt_version": {
      "const": "1.0"
    },
    "recipe": {
      "type": "object"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blender_build": {
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "view": {
            "enum": [
              "FRONT",
              "RIGHT",
              "BACK",
              "THREE_QUARTER"
            ]
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 134217728
          }
        },
        "required": [
          "view",
          "file",
          "sha256",
          "bytes"
        ]
      },
      "minItems": 1,
      "maxItems": 4
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "embedded_preview": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "framing": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "source_saved": {
      "const": false
    }
  },
  "required": [
    "preview_receipt_version",
    "recipe",
    "recipe_sha256",
    "implementation_sha256",
    "blender_build",
    "outputs",
    "candidate",
    "embedded_preview",
    "framing",
    "source_saved"
  ]
}
