{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compositing-template-save-request.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "command": {
      "const": "compositing.template-save"
    },
    "params": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "file",
            "expected_sha256"
          ],
          "additionalProperties": false
        },
        "template_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "producer",
        "template_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "command",
    "params"
  ],
  "additionalProperties": false
}
