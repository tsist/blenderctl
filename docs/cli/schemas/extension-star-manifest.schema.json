{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extension-star-manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "const": "extra_mesh_star_v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "points": {
      "type": "integer",
      "minimum": 3,
      "maximum": 32
    },
    "outer_radius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100
    },
    "inner_radius": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100
    },
    "height": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100
    }
  },
  "required": [
    "adapter",
    "name",
    "points",
    "outer_radius",
    "inner_radius",
    "height"
  ]
}
