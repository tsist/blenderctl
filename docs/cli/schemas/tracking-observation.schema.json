{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tracking-observation 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "markers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 121
                },
                "co": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -1000000000.0,
                    "maximum": 1000000000.0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "mute": {
                  "type": "boolean"
                }
              },
              "required": [
                "frame",
                "co",
                "mute"
              ]
            },
            "minItems": 0,
            "maxItems": 122
          }
        },
        "required": [
          "name",
          "markers"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": -1000000000.0,
                "maximum": 1000000000.0
              },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "frame",
          "matrix"
        ]
      },
      "minItems": 0,
      "maxItems": 120
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "co": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1000000000.0,
              "maximum": 1000000000.0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "name",
          "co"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "tracks",
    "cameras",
    "bundles"
  ]
}
