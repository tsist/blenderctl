  "standalone_products": [
    {
      "id": "hair",
      "name": "Blender Hair Curves",
      "skill": "blender-cli",
      "goals": [
        "character",
        "procedural",
        "shot"
      ],
      "use_when": "在已有工程中制作 Hair Curves 或静态发卡候选。",
      "blender_evidence": {
        "5.3.0": "公共 CLI 生成 Hair Curves、导出静态发卡并独立重开。"
      },
      "scope_reference": "work/audit/<batch>/",
      "action_group": "Hair Curves",
      "editions": [
        "1.0.0"
      ],
      "entry_points": [
        {
          "type": "public",
          "path": "blenderctl.ps1",
          "arguments": [
            "hair",
            "run"
          ],
          "context": "用 --request 提交完整参数。可在子命令前用 --jobs-dir 指定作业目录。"
        }
      ],
      "additional_actions": [
        {
          "scope": "Windows Blender 5.3.0 及以上版本",
          "product": "Hair Curves",
          "version": "1.0.0",
          "action_id": "hair.run",
          "label": "生成 Hair Curves 与静态发卡",
          "gui_source": "Blender Hair Curves",
          "core": "tools/blenderctl/hair_essentials_job.py",
          "cli_command": "hair run",
          "cli_parameter": "--request FILE",
          "status": "已实跑",
          "input": "带场景及发根、表面和发卡设置的 Hair Curves 请求。",
          "output": "生成候选和独立重开回执。发卡用于静态交接。",
          "consumer": "角色制作、渲染及资产交接",
          "recovery": "使用未经修改的源工程重新提交到新目录。",
          "evidence": "公共 CLI 验证曲线生成、静态发卡与独立重开。静态卡片 352 个四边面，GLB 56,540 字节。曲线回执见同目录 groom-receipt.json。",
          "evidence_file": "work/audit/<batch>/",
          "gap_owner": "",
          "reference_type": "公共 CLI 实跑与冷开"
        }
      ]
    }
  ],
