#!/bin/sh
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
workspace=$(CDPATH= cd -- "$base/.." && pwd)
store="$base/jobs/background"
runtime="$workspace/af-exterior-blender53/blender-5.3.0-linux-x64/blender"
verb=${1:?use job or transaction}
shift
for opt; do
 case "$opt" in
  --root|--root=*|--jobs-root|--jobs-root=*|--blender|--blender=*)
   echo "This launcher uses its isolated job store and pinned Blender." >&2; exit 2 ;;
 esac
done
case "$verb" in
 job)
  case "${1:-}" in
   wait|submit-and-wait) exec /usr/bin/python3.13 -I -B "$base/source/linux-flow/keeper.py" --root "$store" "$@" ;;
   _worker) echo 'Internal worker route is not a public command' >&2; exit 2 ;;
   *) exec /usr/bin/python3.13 -I -B "$base/source/linux-flow/jobs/jobs.py" --root "$store" "$@" ;;
  esac
 ;;
 transaction)
  action=${1:?use publish or status}
  shift
  case "$action" in publish|status) ;; *) echo "Use transaction publish or status" >&2; exit 2 ;; esac
  exec /usr/bin/python3.13 -I -B "$base/source/linux-flow/publish/transaction.py" "$action" --jobs-root "$store" --blender "$runtime" "$@" ;;
 *) echo "Use job or transaction" >&2; exit 2 ;;
esac
