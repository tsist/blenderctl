#!/bin/sh
# Opt-in Linux production entry; original CLI remains unchanged.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
workspace=$(CDPATH= cd -- "$base/.." && pwd)
dev="$workspace/af-exterior-linux-dev"
runtime="$workspace/af-exterior-blender53/blender-5.3.0-linux-x64/blender"
group=${1:-}
case "$group" in
 ""|-h|--help)
  cat <<'EOF'
Usage: blenderctl <domain> [command] ...
  inspect, query     Read a self-contained .blend
  scene, model       inspect or prepare a working candidate
  exchange           Export static geometry
  geometry, lighting, compositing
                    Non-rendering Linux adapters
  camera-advanced   Checked motion, cuts, retime and focus
  camera-shots      Inspect native timeline and legacy shot tables, read only
  camera-edit, camera-framing
                    Camera candidate editing / framing diagnostics
  modeling           Local GLB workflow
  reference-contour  Editable closed outline from a verified image
  workbench          Hard Surface Workbench local construction CLI
  job                Submit, inspect, cancel or read a Linux local job
  transaction        Publish a verified candidate to a new path or inspect its receipt
EOF
  ;;
 job|transaction)
  exec "$base/bin/linux-flow" "$@"
  ;;
 geometry|lighting)
  case "${2:-}" in run|inspect) ;; *) echo 'Choose run or inspect' >&2; exit 2;; esac
  exec /usr/bin/python3.13 -B "$base/source/geo-light/scripts/blenderctl_linux.py" --blender "$runtime" --jobs-dir "$base/jobs/geo-light" "$@"
  ;;
 camera-advanced|camera-shots)
  shift
  exec "$base/bin/$group" "$@"
  ;;
 compositing|camera-edit|camera-framing|modeling|reference-contour)
  shift
  exec "$dev/bin/$group-linux" "$@"
  ;;
 workbench)
  shift
  exec "$base/bin/workbench" "$@"
  ;;
 scene|model)
  case "${2:-}" in inspect|prepare) ;; *) echo 'Choose inspect or prepare' >&2; exit 2;; esac
  exec /usr/bin/python3.13 -B "$dev/source/blenderctl/scripts/blenderctl_linux.py" --blender "$runtime" --jobs-dir "$base/jobs/common" "$@"
  ;;
 exchange)
  test "${2:-}" = export || exit 2
  exec /usr/bin/python3.13 -B "$dev/source/blenderctl/scripts/blenderctl_linux.py" --blender "$runtime" --jobs-dir "$base/jobs/common" "$@"
  ;;
 inspect|query|--version)
  exec /usr/bin/python3.13 -B "$dev/source/blenderctl/scripts/blenderctl_linux.py" --blender "$runtime" --jobs-dir "$base/jobs/common" "$@"
  ;;
 *) echo "No verified non-rendering route for: $group" >&2; exit 2 ;;
esac
